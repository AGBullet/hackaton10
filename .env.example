PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME
PGDATABASE=inspector_ai
LM_BASE_URL=http://127.0.0.1:1234/v1
LM_TEXT_MODEL=qwen3.5-4b
LM_VISION_MODEL=qwen3-vl-8b-instruct
LM_TIMEOUT=180
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_DPI=300
DOCKER_LM_BASE_URL=http://host.docker.internal:1234/v1
OCR_MAX_PIXELS=18000000
HOST=127.0.0.1
PORT=8000
WEB_PORT=8000
# 1 = allow temporary public tunnel (cloudflared/ngrok). Keep 0 for local-only.
ALLOW_REMOTE=0
# 1: passwords for administrator and ML role.
# APP_AUTH_SECRET / APP_ADMIN_PASSWORD / APP_ML_PASSWORD generated at first launch.
APP_REQUIRE_ROLE_PASSWORD=1
APP_AUTH_SECRET=CHANGE_TO_RANDOM_64_CHARACTER_VALUE
APP_ADMIN_PASSWORD=CHANGE_TO_STRONG_ADMIN_PASSWORD
APP_ML_PASSWORD=CHANGE_TO_STRONG_ML_PASSWORD
